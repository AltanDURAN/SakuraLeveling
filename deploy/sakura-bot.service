[Unit]
Description=SakuraLeveling Discord Bot
After=network-online.target
Wants=network-online.target
# Le bot maintient une connexion gateway permanente : on le veut résilient
# aux coupures réseau transitoires (StartLimitIntervalSec va dans [Unit]).
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/SakuraLeveling
ExecStart=/home/ubuntu/SakuraLeveling/.venv/bin/python -m app.bot.main
# Mémoire : sans ça, chaque thread de rendu garde son tas et le bot ne rend
# jamais ce qu'il a pris (mesuré : 630 Mo au repos, 150 Mo avec ces réglages).
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
Restart=on-failure
RestartSec=5s

# Sandboxing minimal sans casser l'accès à lita_v2.db ni aux assets générés.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
