DISCORD_TOKEN=your_discord_bot_token_here
# Backend réel de la prod : SQLite local (fichier). Une migration Postgres est
# envisagée à terme (>100 joueurs / multi-serveur) mais l'app tourne en SQLite.
DATABASE_URL=sqlite:///./lita_v2.db
ENV=development
DEBUG=true
BETA_CHANNEL_ID=
ENCOUNTER_CHANNEL_ID=
# Salons où les commandes joueur sont autorisées (IDs séparés par virgule).
# Vide → fallback sur BETA_CHANNEL_ID. Ex : général + zone de farm + world-boss.
COMMAND_CHANNELS=
# Serveur Discord principal (gestion des rôles via l'admin web). 0 = désactivé.
# Nécessite l'intent SERVER MEMBERS + la permission "Gérer les rôles" du bot.
DISCORD_GUILD_ID=
# Accueil des nouveaux membres (on_member_join) : salon de bienvenue + rôle
# attribué automatiquement. 0 = désactivé. Nécessite l'intent SERVER MEMBERS.
WELCOME_CHANNEL_ID=
DEFAULT_MEMBER_ROLE_ID=
# Rôles de RANG (accès aux zones de farm par palier). Format "RANG:role_id"
# séparés par des virgules. Tout le monde démarre au Rang F (attribué auto au
# 1er /demarrer, /profil ou on_member_join) ; montée via épreuves (à venir) ou
# /admin set_rank. Le bot doit avoir "Gérer les rôles" + être au-dessus d'eux.
# Ex : RANK_ROLE_IDS=F:111,E:222,D:333,C:444,B:555,A:666,S:777,SS:888,SSS:999
RANK_ROLE_IDS=
# Channel des world bosses. Si vide ou 0, fallback vers ENCOUNTER_CHANNEL_ID.
# IDs de référence fournis par le user :
#   • prod / beta : 1500256259687972915
#   • dev (local) : 1421477764099342377
BOSS_CHANNEL_ID=
# URL publique du webapp skill tree (bouton 'Vue détaillée' du /skill).
# Local : http://localhost:8000  /  Prod : http://<IP_VPS>/  ou https://ton-domaine.com/
WEBAPP_BASE_URL=http://localhost:8000
# Liste des Discord IDs admins (séparés par des virgules) pour les commandes /admin
ADMIN_DISCORD_IDS=

# --- Webapp admin (OAuth Discord) ---
# Client ID/secret de l'app Discord (Developer Portal > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# URL EXACTE à enregistrer dans Discord Portal > OAuth2 > Redirects.
# Ex prod : http://<IP_VPS>:8001/admin/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8001/admin/auth/callback
# Secret de signature des cookies de session admin (itsdangerous).
# OBLIGATOIRE : la webapp REFUSE de démarrer si ce secret reste au défaut.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SESSION_SECRET=
# Cookies en Secure (HTTPS only). True en prod derrière TLS, False en local HTTP.
ADMIN_COOKIE_SECURE=false